# RunLeak example env — PLACEHOLDERS ONLY. Never put real keys here.
# Copy to .env.local (which is gitignored) and fill values locally if needed.

# Future-safe names for the optional, opt-in local provider live test.
# Live provider tests run ONLY when this is exactly "true". Default off.
RUNLEAK_PROVIDER_TEST_ENABLED=false

# Provider keys are user-owned and supplied locally at runtime. Leave blank here.
# Do NOT commit real values. Do NOT create .env.local in the repo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model id for the optional Anthropic live smoke test (e.g. a small Claude model).
# Required (alongside the flag + key) for the live smoke test to run; blank = skip.
ANTHROPIC_LIVE_TEST_MODEL=

# Model id for the optional Gemini live smoke test.
# Required (alongside the flag + key) for the live smoke test to run; blank = skip.
GEMINI_LIVE_TEST_MODEL=gemini-2.5-flash-lite

# --- Supabase (optional) ---------------------------------------------------
# Powers trace-submission persistence and the admin panel. When these are
# blank the app degrades gracefully: intake is accepted but not stored.
# Fill these in .env.local (gitignored) — never commit real values.
# After setting them, run supabase-schema.sql in the Supabase SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
# Safe for browser use. Prefer the modern sb_publishable_ key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Random server-only value used to pseudonymize client addresses in durable
# rate-limit buckets. Generate independently; never expose it to the browser.
RATE_LIMIT_PEPPER=
# Optional global API request-body ceiling. Defaults to 4 MiB.
MAX_API_BODY_BYTES=4194304

# --- Email (Resend, optional) ----------------------------------------------
# When unset, email silently no-ops. RESEND_FROM must be a verified sender; for
# testing you can use "OathLock <onboarding@resend.dev>" (only sends to your own
# Resend account email until you verify a domain).
RESEND_API_KEY=
RESEND_FROM=
# Inbox alerted on every new audit request. Defaults to the public contact address.
AUDIT_NOTIFY_EMAIL=

# --- Instant lead notifications (Discord or Slack webhook, optional) --------
# Get a ping the moment a lead comes in. One URL works for either platform.
#   Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
#   Slack:   api.slack.com/apps → Incoming Webhooks → Add → Copy URL
# When unset, webhook notifications silently no-op.
LEAD_WEBHOOK_URL=

# --- New-signup notifications (Supabase Database Webhook, optional) ----------
# Get a ping the moment someone creates an account (email OR OAuth). Wire it in
# Supabase: Database → Webhooks → new hook on auth.users (Insert) → HTTP POST to
#   https://<your-domain>/api/hooks/new-signup
# and add an HTTP header  x-signup-secret: <same value as SIGNUP_WEBHOOK_SECRET>.
# The alert posts to SIGNUP_WEBHOOK_URL, or LEAD_WEBHOOK_URL if that's blank.
SIGNUP_WEBHOOK_SECRET=
SIGNUP_WEBHOOK_URL=

# --- Public site URL (required for correct absolute links in agent.md, etc.) -
NEXT_PUBLIC_SITE_URL=

# --- Raw terminal multiplayer view (experimental, off by default) ------------
# The shared-PTY terminal view (the Chat <-> Terminal toggle in a channel
# header) is unfinished and stays hidden until it meets the polish bar.
# Setting this to true restores the Terminal toggle and re-registers the
# handoff_to_terminal agent tool. Unrelated to `npx m9r-cli terminal runtime`.
NEXT_PUBLIC_M9R_TERMINAL_ENABLED=false

# --- Billing (Stripe, optional) ---------------------------------------------
# Powers subscriptions/plan-limit enforcement. When unset, billing routes
# degrade (no charges can be made, no webhook events are accepted).
# Billing is opt-in. Leave this false/blank while Stripe is being repaired;
# individual workspace access remains open and no checkout is shown.
NEXT_PUBLIC_M9R_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
# Signature-verified against the raw webhook body — never trust an unsigned event.
STRIPE_WEBHOOK_SECRET=

# --- GitHub App (repo bindings, PR provenance, optional) --------------------
# Signature-verified against the raw request body before any JSON parsing.
GITHUB_APP_WEBHOOK_SECRET=

# --- Mission Relay (real-time Watchfloor activity, optional) ----------------
# When unset, the relay-token route returns 503 and the app falls back to the
# HTTP polling path instead of the live WebSocket relay.
MISSION_RELAY_PUBLIC_URL=
MISSION_RELAY_TOKEN_SECRET=

# --- Mission git attestation signing (optional) -----------------------------
# Base64-encoded PKCS8 Ed25519 private key. When unset, git authorization
# attestations are simply omitted (a fact the UI shows, never silently
# backfilled) rather than blocking the git operation itself.
MISSION_GIT_ATTESTATION_SIGNING_KEY=

# --- Web push notifications (VAPID, optional) -------------------------------
# Generate with `npx web-push generate-vapid-keys`. When unset, push
# notifications silently no-op.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Internal cron routes (required if you deploy the scheduled crons) ------
# Gates /api/internal/{stale-run-sweep,work-signal-sweep,workflow-scheduler} --
# these run on a schedule, never on end-user request, so they're checked
# against this shared secret instead of a per-user session/token.
CRON_SECRET=

# --- Jev / TypeSafe (DISABLED: the API is paid; keep M9R_JEV_MODE=off) ---
# M9R_JEV_MODE: off (default) | mock (no network, deterministic) | shadow (judges each human message and logs
# next to the existing routing; changes nothing). Shadow sends message text to TypeSafe and needs the key below.
M9R_JEV_MODE=off
TYPESAFE_API_KEY=
