{
  "manifest_version": 3,
  "name": "M9R Web Presence (dev)",
  "version": "0.0.2",
  "description": "Lets agents work in shared browser tabs through M9R and shows where each one is acting. Development build, localhost only.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage",
    "tabGroups"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "permission.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/presence-logic.js",
        "src/presence-overlay.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/providers/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "pill.html",
        "composer.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "toggle-message-bar": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Show or hide the M9R message bar"
    },
    "toggle-thread-pill": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Show or hide the M9R agent thread pill"
    }
  }
}
