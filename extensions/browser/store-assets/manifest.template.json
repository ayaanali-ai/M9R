{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "M9R Web Presence",
  "version": "0.1.0",
  "description": "Connect your approved M9R agents to ordinary websites and shared browser tabs.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage",
    "nativeMessaging",
    "search"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/providers/*.svg",
        "pill-next/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "permission.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
