{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "pill/src/**/*.d.ts"
  ],
  "exclude": [
    "services/network-core",
    "services/cron-scheduler",
    "services/relay-do",
    "services/web-coordinator",
    "services/mission-bridge/src/worker-wrapper.ts",
    "services/mission-relay/src/worker-wrapper.ts",
    "services/mission-worker/src/worker-wrapper.ts",
    "scripts/cloudflare-scheduler.test.ts",
    "node_modules",
    "extensions",
    "overlay",
    "pill/vite.config.ts",
    "runleak-analyzer-mvp",
    ".m9r",
    "**/.m9r/**",
    ".worktrees",
    "**/.worktrees/**",
    ".release-excluded",
    "**/.release-excluded/**",
    ".m9r-recovery-quarantine-*",
    "**/.m9r-recovery-quarantine-*/**",
    ".test-tmp*",
    "**/.test-tmp*/**",
    "scratchpad",
    "**/scratchpad/**",
    "diagnostics",
    "**/diagnostics/**"
  ]
}
