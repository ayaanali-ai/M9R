{
  "$schema": "https://schemas.cloudflare.com/wrangler.json",
  "name": "m9r-relay-do",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "WorkspaceHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceHub"] }],
  // Database and product logic lives in the web app (services/relay-do never talks to Supabase).
  "services": [{ "binding": "WEB", "service": "app" }],
  "vars": {
    "WEB_RPC_URL": "https://app.m9r.workers.dev/api/internal/relay/rpc"
  },
  "observability": { "enabled": true }
}
