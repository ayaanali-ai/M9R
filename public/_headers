# Cloudflare Workers Static Assets serves files under public/ directly, bypassing the Next.js request handler and its
# next.config.ts `headers()` — confirmed from the ZAP scan: /offline, /try/*, and every /_next/static/media/*.woff2 font had
# none of the app's security headers (HSTS, X-Content-Type-Options, CSP, anti-clickjacking). This file is Cloudflare's own
# mechanism for setting headers on assets served this way, so every response carries the baseline regardless of path.
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Resource-Policy: same-origin

# The /try demo page and the offline fallback are plain static HTML with no inline or third-party scripts (verified: no
# <script> tags beyond same-origin files, no fetch/WebSocket calls, one inline style attribute). They never need the main
# app's Supabase/relay/extension connect-src or frame-src, so they get their own minimal, stricter policy.
/try/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/offline.html
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Confirmed by Twitter/Slack/iMessage link-preview crawlers needing a cross-origin embed (see next.config.ts's og-v2.png
# note); that next.config override only applies if this file is ever served by the Worker instead of the asset binding, so
# it is restated here as the one that actually reaches the response.
/og-v2.png
  Cross-Origin-Resource-Policy: cross-origin
